# ---- Runtime ----
NODE_ENV=development
PORT=8787
# IANA timezone used to decide what "today" means for trips and absences.
APP_TIMEZONE=Asia/Baghdad

# ---- Database (MySQL 8+) ----
DATABASE_URL="mysql://rakaz:CHANGE_ME@127.0.0.1:3306/rakaz"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---- HTTP ----
# Comma-separated list of dashboard origins allowed by CORS. Mobile apps are not affected by CORS.
CORS_ORIGINS=http://localhost:5173
# Set to true only when the API sits behind nginx / CloudPanel (needed for correct client IPs).
TRUST_PROXY=false
# Serve Swagger UI at /api/docs. Keep false in production unless you need it.
SWAGGER_ENABLED=true

# ---- First administrator (used by `npm run db:seed`) ----
ADMIN_PHONE=07700000000
# Quote the value if it contains # or spaces.
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
ADMIN_NAME="مدير النظام"
# Set to true to also insert a demo school, driver, route and students (never in production).
SEED_DEMO=false

# ---- Push notifications (optional) ----
# Expo access token, only needed when "Enhanced Security for Push Notifications" is on in the Expo project.
EXPO_ACCESS_TOKEN=

# ---- OpenStreetMap address lookup for driver check-ins (optional) ----
# The public service allows light use only (about one request per second). Leave the URL empty to
# turn the lookup off, or point it at your own Nominatim server.
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_CONTACT_EMAIL=

{
  "name": "@rakaz/contract",
  "version": "1.0.0",
  "private": true,
  "description": "Shared linking contract between Rakaz apps, dashboard, and API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.4",
    "typescript": "~5.9.2"
  },
  "files": [
    "dist",
    "src"
  ]
}

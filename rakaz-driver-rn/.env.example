# Base URL of rakaz-api, no trailing slash. Must be HTTPS for store builds.
# On a real phone during development use your computer's LAN address, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_RAKAZ_API_URL=http://127.0.0.1:8787

# Google Maps key for Android (Maps SDK for Android enabled).
GOOGLE_MAPS_API_KEY=

# Printed by `npx eas-cli init`. Needed for EAS builds and push notifications.
EAS_PROJECT_ID=

{
  "expo": {
    "name": "ركاز السائق",
    "slug": "rakaz-driver-rn",
    "version": "1.0.0",
    "scheme": "rakazdriver",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F1EC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alsultan.rikaz.driver",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze",
          "tel"
        ],
        "CFBundleDevelopmentRegion": "ar",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.alsultan.rikaz.driver",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rakaz_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#10233F"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true,
          "supportedLocales": [
            "ar"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم ركاز موقعك لعرض موقع الباص على الخريطة وتسجيل الوصول والاستلام والتسليم.",
          "locationAlwaysAndWhenInUsePermission": "يشارك ركاز موقع الباص مع أولياء الأمور والإدارة طوال الرحلة حتى لو كانت الشاشة مقفلة، ويتوقف عند انتهاء الرحلة.",
          "locationAlwaysPermission": "يشارك ركاز موقع الباص مع أولياء الأمور والإدارة طوال الرحلة حتى لو كانت الشاشة مقفلة، ويتوقف عند انتهاء الرحلة.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C09034"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
